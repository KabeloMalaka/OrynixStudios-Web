# Serve the React SPA for any path that is not a real file or directory.
# Without this, deep links like /ham/terms 404 because only /index.html exists on disk.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files and directories alone (assets, favicon.svg, icons.svg, ...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: hand it to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Hashed build assets are immutable; index.html must never be cached.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
