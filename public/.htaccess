# Serve the React SPA for any path that is not a real file or directory.
# Without this, deep links like /ham/terms 404 because only /index.html exists on disk.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files and directories alone (assets, images, ...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: hand it to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Only Vite's hashed build output in /assets/ is immutable (its filenames change with content).
# Everything else (index.html, favicon, any un-hashed file) must revalidate, or browsers
# keep serving stale copies for a year after the file changes or is removed.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    Header set Cache-Control "no-cache"
  </Else>
</IfModule>
